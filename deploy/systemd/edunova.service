[Unit]
Description=EduNova Flask Backend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/edunova
Environment="PATH=/opt/edunova/venv/bin"
ExecStart=/opt/edunova/venv/bin/gunicorn --workers 2 --threads 4 --timeout 300 --bind 127.0.0.1:5001 backend.main:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
